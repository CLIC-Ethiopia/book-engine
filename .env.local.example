# ============================================================
# Environment Variables for LLM Providers
# Copy this file to .env.local and fill in your API keys
# .env.local is gitignored - never commit real keys!
# ============================================================

# ============================================================
# CLI Agents (optional overrides)
# ============================================================
# OPENCODE_COMMAND=opencode
# CLAUDE_COMMAND=claude
# AGY_COMMAND=agy

# ============================================================
# API Providers
# ============================================================

# Google Gemini
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Custom OpenAI-Compatible Provider (e.g., Together.ai, Groq, etc.)
# CUSTOM_API_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=

# ============================================================
# MCP / Session Configuration
# ============================================================
# MCP Server URL for connecting to coding agent session
MCP_SERVER_URL=http://localhost:3456

# Skill to use with MCP connection
MCP_SKILL=chat

# ============================================================
# Optional: Default Model Settings
# ============================================================
# DEFAULT_TEMPERATURE=0.7
# DEFAULT_STREAMING=true

# ============================================================
# Model Overrides (optional)
# ============================================================
# GEMINI_MODEL=gemini-1.5-pro
# OPENAI_MODEL=gpt-4-turbo-preview
# ANTHROPIC_MODEL=claude-3-opus-20240229
# CUSTOM_MODEL=your-model-name