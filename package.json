{
  "name": "book-engine",
  "version": "1.0.0",
  "description": "Write one page at a time. Get a real book. A strict B5 page engine for AI-authored books.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node engine/tools/build-book.mjs",
    "check": "node engine/tools/check.mjs",
    "shot": "node engine/tools/shot.mjs",
    "export": "node engine/tools/export.mjs",
    "image": "node engine/tools/gen-image.mjs",
    "ideas": "node engine/tools/ideas-to-book.mjs",
    "test": "node --test test/*.test.mjs",
    "new-idea": "node engine/tools/new-idea-cli.mjs",
    "new-idea:bridge": "node engine/tools/new-idea-bridge-handler.mjs",
    "new-idea:dev": "concurrently \"python -m http.server 3000\" \"npm run new-idea:bridge\"",
    "webui:server": "node engine/tools/webui-server.mjs",
    "webui:bridge": "node engine/tools/bridge-handler.mjs",
    "webui:dev": "concurrently \"npm run webui:server\" \"npm run webui:bridge\""
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "execa": "^10.0.1",
    "express": "^5.3.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "marked": "^12.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.48.0"
  }
}
